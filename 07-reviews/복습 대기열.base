filters:
  and:
    - file.hasProperty("next_review")
    - next_review != null
    - '!file.inFolder("08-templates")'
views:
  - type: table
    name: 복습 대기열
    order:
      - file.name
      - type
      - domains
      - level
      - last_reviewed
      - next_review
    sort:
      - property: next_review
        direction: ASC
